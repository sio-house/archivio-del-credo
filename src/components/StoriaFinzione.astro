---
import { render, type CollectionEntry } from 'astro:content';
interface Props { v: CollectionEntry<'verita'>; titolo?: string }
const { v, titolo = 'Storia e finzione' } = Astro.props;
const { Content } = await render(v);
const host = (u: string) => new URL(u).hostname.replace('www.', '');
---
<section class="sf" id="storia">
  <h2>{titolo}</h2>
  <div class="contesto" data-sync><Content /></div>
  <div class="colonne">
    <div class="card vero" data-sync>
      <p class="eyebrow">È successo davvero</p>
      <ul>{v.data.reali.map((x) => <li>{x}</li>)}</ul>
    </div>
    <div class="card finto" data-sync>
      <p class="eyebrow">Inventato</p>
      <ul>{v.data.inventati.map((x) => <li>{x}</li>)}</ul>
    </div>
  </div>
  {v.data.licenze.length > 0 && (
    <div class="card licenze" data-sync>
      <p class="eyebrow">Dove la storia è stata piegata</p>
      <ul>{v.data.licenze.map((x) => <li>{x}</li>)}</ul>
    </div>
  )}
  {v.data.fonti.length > 0 && (
    <p class="small muted">Fonti storiche: {v.data.fonti.map((f, i) => <>{i > 0 && ', '}<a href={f} rel="noopener">{decodeURIComponent(host(f) + new URL(f).pathname.replace('/wiki/', '/'))}</a></>)}</p>
  )}
  {v.data.fontiInterne.length > 0 && (
    <p class="small muted">Dal materiale in collezione: {v.data.fontiInterne.map((f, i) => <>{i > 0 && ', '}{f.riferimento}</>)}</p>
  )}
</section>
<style>
  .sf { margin-top: 2.4em; }
  .contesto { max-width: 65ch; font-size: 1.05rem; }
  .contesto :global(p) { margin: 0 0 1em; }
  .colonne { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  @media (max-width: 760px) { .colonne { grid-template-columns: 1fr; } }
  .sf ul { margin: 0; padding-left: 20px; display: grid; gap: 8px; font-size: .95rem; }
  .vero { border-left: 3px solid var(--aff-storia, #2f7d5b); }
  .vero li::marker { color: #2f7d5b; }
  .finto { border-left: 3px solid var(--accent); }
  .finto li::marker { color: var(--accent); }
  .licenze { border-left: 3px solid var(--gold); max-width: 70ch; }
  .licenze li::marker { color: var(--gold); }
  .eyebrow { margin: 0 0 10px; }
</style>
