---
/**
 * Emblema originale dell'Archivio: un anello spezzato in otto archi,
 * una gemma divisa da una fenditura verticale, un punto al centro.
 * Ogni pezzo porta data-frammento, così l'intro può farlo ricomporre.
 */
interface Props { size?: number | string; class?: string; titolo?: string }
const { size = 40, class: cls = '', titolo } = Astro.props;
const C = 60, R = 50, GAP = 9;
const pt = (a: number, r = R) => {
  const t = ((a - 90) * Math.PI) / 180;
  return `${(C + r * Math.cos(t)).toFixed(2)} ${(C + r * Math.sin(t)).toFixed(2)}`;
};
// otto archi, con le interruzioni sui punti cardinali e sulle diagonali
const archi = Array.from({ length: 8 }, (_, i) => {
  const a1 = i * 45 + GAP / 2, a2 = (i + 1) * 45 - GAP / 2;
  return `M ${pt(a1)} A ${R} ${R} 0 0 1 ${pt(a2)}`;
});
const tacche = [0, 90, 180, 270].map((a) => `M ${pt(a, 38)} L ${pt(a, 43)}`);
const schegge = [
  '58,20 58,57 35,60', '35,60 58,63 58,100',
  '62,20 62,57 85,60', '85,60 62,63 62,100',
];
---
<svg class={`glifo ${cls}`} viewBox="0 0 120 120" width={size} height={size}
  role={titolo ? 'img' : undefined} aria-hidden={titolo ? undefined : 'true'} aria-label={titolo}>
  <g class="glifo-anello" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="butt">
    {archi.map((d) => <path d={d} data-frammento />)}
  </g>
  <g class="glifo-tacche" fill="none" stroke="currentColor" stroke-width="2.5">
    {tacche.map((d) => <path d={d} data-frammento />)}
  </g>
  <g class="glifo-gemma" fill="currentColor">
    {schegge.map((p) => <polygon points={p} data-frammento />)}
  </g>
  <circle class="glifo-occhio" cx="60" cy="60" r="3.2" fill="var(--glifo-occhio, currentColor)" data-frammento />
</svg>
