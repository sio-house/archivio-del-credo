---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { dati, TIPI, anno } from '../../lib/data';
const { perUscita } = await dati();
---
<Base titolo="Opere">
  <h1>Opere</h1>
  <p class="muted">Tutto il franchise in ordine di uscita. Per i giochi c'è anche il confronto fra <a href={u('/storia')}>storia e finzione</a>.</p>
  <div class="grid">
    {perUscita.map((o) => (
      <a class="card" href={u(`/opere/${o.id}`)}>
        <p class="eyebrow">{TIPI[o.data.tipo]} · {anno(o.data.uscita)}</p>
        <h2>{o.data.titolo}</h2>
        <p class="small muted">{o.data.studio ?? o.data.autori.join(', ')}</p>
        {!o.data.verificato && <span class="tag warn">da verificare</span>}
      </a>
    ))}
  </div>
</Base>
