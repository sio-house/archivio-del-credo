---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Glifo from '../components/Glifo.astro';
import { dati } from '../lib/data';
import { getCollection } from 'astro:content';
const { opere, segmenti, personaggi, copie, percorsi, glossario, verita } = await dati();
const luoghi = await getCollection('luoghi');
const ultime = (await getCollection('notizie')).sort((a, b) => +b.data.data - +a.data.data).slice(0, 4);
const possedute = copie.filter((c) => c.data.stato === 'posseduto').length;
const data = (d: Date) => d.toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// l'indice del codice: numero romano, voce, cosa contiene, quanto è grande
const indice = [
  { href: '/timeline', nome: 'Timeline', desc: 'Epoca storica ed epoca moderna, in ordine di storia o di uscita.', conta: `${segmenti.length} momenti`, icona: 'linea' },
  { href: '/percorsi', nome: 'Percorsi', desc: 'Cosa leggere e giocare, in che ordine, e cosa si può saltare.', conta: `${percorsi.length + 2} guide`, icona: 'sentiero', nota: 'se sei nuovo, parti da qui' },
  { href: '/mappa', nome: 'Mappa', desc: 'I luoghi della saga e i viaggi dei personaggi.', conta: `${luoghi.length} luoghi`, icona: 'bussola' },
  { href: '/opere', nome: 'Opere', desc: 'Giochi, romanzi, fumetti, manga e corti, con fonti.', conta: `${opere.length} opere`, icona: 'libro' },
  { href: '/personaggi', nome: 'Personaggi', desc: 'Schede, legami di sangue e alleanze, con il grafo delle relazioni.', conta: `${personaggi.length} schede`, icona: 'volto' },
  { href: '/storia', nome: 'Storia e finzione', desc: 'Cosa prendono dalla storia i giochi, e cosa inventano.', conta: `${verita.length} confronti`, icona: 'bilancia' },
  { href: '/glossario', nome: 'Glossario', desc: 'Isu, Animus, Frutti dell\'Eden: le parole del Credo.', conta: `${glossario.length} voci`, icona: 'penna' },
  { href: '/collezione', nome: 'Collezione', desc: 'Edizioni, stato e note della collezione personale.', conta: `${possedute} pezzi`, icona: 'scaffale' },
];
const romani = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
// piccole icone disegnate a tratto, tutte originali
const icone: Record<string, string> = {
  linea: '<path d="M3 12h18"/><circle cx="7" cy="12" r="2"/><circle cx="14" cy="12" r="2"/><path d="M19 9v6"/>',
  sentiero: '<path d="M4 20c4-2 2-6 7-7s4-6 9-8"/><circle cx="20" cy="5" r="1.4"/><path d="M3 19l2 2M5 19l-2 2"/>',
  bussola: '<circle cx="12" cy="12" r="9"/><path d="M12 5l2.2 7L12 19l-2.2-7z"/>',
  libro: '<path d="M4 5c3-1 6-1 8 1 2-2 5-2 8-1v14c-3-1-6-1-8 1-2-2-5-2-8-1z"/><path d="M12 6v14"/>',
  volto: '<path d="M12 3c4 0 7 3 7 8l-3 3v6H8v-6l-3-3c0-5 3-8 7-8z"/><path d="M9 12l3 1 3-1"/>',
  bilancia: '<path d="M12 4v16M7 20h10M5 7h14"/><path d="M5 7l-2.5 6h5zM19 7l-2.5 6h5z"/>',
  penna: '<path d="M20 3C12 5 7 11 5 19l2-1c1-4 4-8 8-10"/><path d="M4 21l3-3"/>',
  scaffale: '<path d="M3 20h18"/><rect x="4" y="6" width="3" height="14"/><rect x="8" y="4" width="3" height="16"/><path d="M13 7l3-1 4 13-3 1z"/>',
};
---
<Base titolo="Home">
  <section class="frontespizio">
    <div class="testo">
      <p class="eyebrow" data-sync>Portale non ufficiale · codice di consultazione</p>
      <h1 data-sync>Tutto il Credo, in ordine.</h1>
      <p class="lead" data-sync>Giochi, romanzi, fumetti, manga e corti di <em>Assassin's Creed</em> messi su un'unica linea del tempo, con i percorsi di lettura e la collezione che li tiene insieme.</p>
      <p class="mano nota-cerca" data-sync aria-hidden="true">cerca un nome, un anno, un luogo <span class="freccia">↓</span></p>
      <div id="search" class="search" data-sync></div>
    </div>
    <div class="sigillo" aria-hidden="true">
      <Glifo size="100%" />
    </div>
  </section>

  <div class="corpo">
    <nav class="indice" aria-labelledby="titolo-indice">
      <h2 id="titolo-indice" data-sync>Indice</h2>
      <ol>
        {indice.map((v, i) => (
          <li data-sync>
            <a href={u(v.href)}>
              <span class="num">{romani[i]}</span>
              <svg class="icona" viewBox="0 0 24 24" aria-hidden="true" set:html={icone[v.icona]} />
              <span class="voce">
                <span class="riga"><span class="nome">{v.nome}</span><span class="puntini" aria-hidden="true"></span><span class="conta">{v.conta}</span></span>
                <span class="desc">{v.desc}</span>
              </span>
            </a>
            {v.nota && <span class="mano nota" aria-hidden="true">↑ {v.nota}</span>}
          </li>
        ))}
      </ol>
      <p class="small muted appendice" data-sync>Appendici: <a href={u('/personaggi/grafo')}>grafo delle relazioni</a> · <a href={u('/storia/piani')}>i tre piani del racconto</a> · <a href={u('/collezione/mancanti')}>cosa manca alla collezione</a></p>
    </nav>

    <aside class="dispacci" aria-labelledby="titolo-dispacci">
      <h2 id="titolo-dispacci" data-sync>Dispacci</h2>
      <ul>
        {ultime.map((n) => (
          <li data-sync>
            <p class="eyebrow"><time datetime={n.data.data.toISOString().slice(0, 10)}>{data(n.data.data)}</time>{n.data.stato === 'indiscrezione' && <span class="tag warn">indiscrezione</span>}</p>
            <a href={u(`/notizie#${n.id}`)}>{n.data.titolo}</a>
          </li>
        ))}
      </ul>
      <p class="small"><a href={u('/notizie')}>Tutti i dispacci →</a></p>
    </aside>
  </div>

  <Fragment slot="head">
    <link href={u('/pagefind/pagefind-ui.css')} rel="stylesheet" />
    <script is:inline src={u('/pagefind/pagefind-ui.js')}></script>
    <script is:inline>
      const avviaRicerca = () => {
        const box = document.getElementById('search');
        if (window.PagefindUI && box && !box.dataset.pronto) {
          box.dataset.pronto = '1';
          new PagefindUI({ element: '#search', showImages: false, translations: { placeholder: 'Cerca opere, personaggi, luoghi…' } });
        }
      };
      window.addEventListener('DOMContentLoaded', avviaRicerca);
      // il campo di Pagefind arriva senza etichetta accessibile
      const etichetta = () => document.querySelector('#search input')?.setAttribute('aria-label', 'Cerca nel sito');
      document.addEventListener('astro:page-load', etichetta);
      setTimeout(etichetta, 300);
      document.addEventListener('astro:page-load', avviaRicerca);
    </script>
  </Fragment>
</Base>
<style>
  .frontespizio { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: center; padding-bottom: 36px; border-bottom: 3px double var(--line); }
  @media (min-width: 860px) { .frontespizio { grid-template-columns: 1.55fr 1fr; gap: 48px; } }
  .lead { font-size: 1.2rem; max-width: 56ch; }
  .nota-cerca { margin: 22px 0 -6px 4px; rotate: -1.5deg; }
  .freccia { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) { .freccia { animation: dondola 2.2s ease-in-out infinite; } }
  @keyframes dondola { 50% { translate: 0 4px; } }
  .search { margin: 12px 0 0; --pagefind-ui-font: var(--sans); --pagefind-ui-border: var(--line); --pagefind-ui-background: var(--surface); --pagefind-ui-text: var(--ink); --pagefind-ui-primary: var(--accent); --pagefind-ui-border-radius: 3px; }

  /* il glifo come un sigillo impresso sulla pagina */
  .sigillo { display: none; justify-self: center; width: min(300px, 100%); aspect-ratio: 1; color: var(--ink); opacity: .1; rotate: -8deg; }
  .sigillo :global(.glifo-gemma), .sigillo :global(.glifo-occhio) { color: var(--accent); fill: var(--accent); }
  @media (min-width: 860px) { .sigillo { display: block; } }
  @media (prefers-color-scheme: dark) { .sigillo { opacity: .14; } }

  .corpo { display: grid; gap: 8px 56px; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .corpo { grid-template-columns: 1.7fr 1fr; } }

  .indice ol { list-style: none; margin: 0; padding: 0; }
  .indice li { position: relative; border-bottom: 1px dashed var(--line); }
  .indice li a { display: grid; grid-template-columns: 2.6rem 26px 1fr; gap: 14px; align-items: start; padding: 14px 4px; text-decoration: none; transition: background .2s, padding .2s; }
  .indice li a:hover { color: inherit; background: color-mix(in srgb, var(--surface) 70%, transparent); padding-left: 10px; }
  .num { font: 500 1.05rem/1.9 var(--serif); color: var(--accent); text-align: right; font-variant-numeric: lining-nums; }
  .icona { width: 24px; height: 24px; margin-top: 5px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; color: var(--muted); transition: color .2s, rotate .3s; }
  .indice li a:hover .icona { color: var(--accent); rotate: -8deg; }
  .riga { display: flex; align-items: baseline; gap: 8px; }
  .nome { font: 600 1.45rem/1.3 var(--serif); }
  .puntini { flex: 1; border-bottom: 2px dotted color-mix(in srgb, var(--muted) 55%, transparent); translate: 0 -5px; min-width: 20px; }
  .conta { font: .75rem var(--mono); letter-spacing: .06em; color: var(--muted); white-space: nowrap; }
  .desc { display: block; color: var(--muted); font-size: .98rem; }
  .indice .nota { display: block; margin: -10px 0 12px 5.6rem; rotate: -1.2deg; font-size: 1.3rem; }
  .appendice { margin-top: 18px; }

  .dispacci ul { list-style: none; margin: 0; padding: 0; }
  .dispacci li { padding: 12px 0 14px; border-bottom: 1px dashed var(--line); }
  .dispacci li .eyebrow { margin: 0 0 4px; display: flex; gap: 8px; align-items: center; }
  .dispacci li a { font: 500 1.2rem/1.3 var(--serif); text-decoration: none; }
  .dispacci li a:hover { text-decoration: underline; }
  @media (min-width: 860px) {
    .dispacci { background: var(--surface); border: 1px solid var(--line); box-shadow: var(--ombra); padding: 4px 22px 16px; align-self: start; margin-top: 2.2em; rotate: .6deg; }
    .dispacci h2 { margin-top: .8em; }
  }
  :global(:root[data-animus='on']) .dispacci, :global(:root[data-animus='on']) .sigillo { rotate: none; }
  :global(:root[data-animus='on']) .indice .nota, :global(:root[data-animus='on']) .nota-cerca { font-size: .78rem; rotate: none; }
</style>
