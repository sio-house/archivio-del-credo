---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Scaffale from '../components/Scaffale.astro';
import { dati, TIPI } from '../lib/data';
import { getCollection } from 'astro:content';
const { opere, segmenti, personaggi, copie, percorsi, glossario, verita, idx, perUscita, perCronologia } = await dati();
const luoghi = await getCollection('luoghi');
const ultime = (await getCollection('notizie')).sort((a, b) => +b.data.data - +a.data.data).slice(0, 4);
const mie = copie.filter((c) => c.data.stato === 'posseduto');
const possedute = mie.length;
const opereMie = new Set(mie.map((c) => idx.edizioni.get(c.data.edizione.id)!.data.opera.id));
// ordine di storia: la prima epoca raccontata da ogni opera; senza epoche, in coda per uscita
const primaVolta = new Map<string, number>();
perCronologia.forEach((s, i) => { if (!primaVolta.has(s.data.opera.id)) primaVolta.set(s.data.opera.id, i); });
const perStoria = [...perUscita].sort((a, b) => (primaVolta.get(a.id) ?? 1e9) - (primaVolta.get(b.id) ?? 1e9));
const tipiPresenti = [...new Set(opere.map((o) => o.data.tipo))];
const data = (d: Date) => d.toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// le sezioni del sito, con una riga di descrizione
const indice = [
  { href: '/timeline', nome: 'Timeline', desc: 'Tutte le storie sulla linea del tempo, dagli Isu fino al futuro di Black Flag Resynced.', conta: `${segmenti.length} voci`, icona: 'linea' },
  { href: '/percorsi', nome: 'Percorsi', desc: 'In che ordine giocare e leggere, e cosa si può saltare. Se non sai da dove cominciare, parti da qui.', conta: `${percorsi.length + 2} guide`, icona: 'sentiero' },
  { href: '/mappa', nome: 'Mappa', desc: 'Dove è ambientata ogni storia, con i viaggi di alcuni personaggi.', conta: `${luoghi.length} luoghi`, icona: 'bussola' },
  { href: '/opere', nome: 'Opere', desc: 'Una scheda per ogni gioco, romanzo, fumetto, manga e corto.', conta: `${opere.length} opere`, icona: 'libro' },
  { href: '/personaggi', nome: 'Personaggi', desc: 'Protagonisti e comprimari, con parentele e alleanze.', conta: `${personaggi.length} schede`, icona: 'volto' },
  { href: '/storia', nome: 'Storia e finzione', desc: 'Gioco per gioco, cosa è successo veramente e cosa è inventato.', conta: `${verita.length} confronti`, icona: 'bilancia' },
  { href: '/glossario', nome: 'Glossario', desc: 'Isu, Animus, Frutti dell\'Eden e le altre parole che tornano sempre.', conta: `${glossario.length} voci`, icona: 'penna' },
  { href: '/collezione', nome: 'Collezione', desc: 'Quello che ho sullo scaffale, edizione per edizione.', conta: `${possedute} pezzi`, icona: 'scaffale' },
];
// piccole icone disegnate a tratto, tutte originali
const icone: Record<string, string> = {
  linea: '<path d="M3 12h18"/><circle cx="7" cy="12" r="2"/><circle cx="14" cy="12" r="2"/><path d="M19 9v6"/>',
  sentiero: '<path d="M4 20c4-2 2-6 7-7s4-6 9-8"/><circle cx="20" cy="5" r="1.4"/><path d="M3 19l2 2M5 19l-2 2"/>',
  bussola: '<circle cx="12" cy="12" r="9"/><path d="M12 5l2.2 7L12 19l-2.2-7z"/>',
  libro: '<path d="M4 5c3-1 6-1 8 1 2-2 5-2 8-1v14c-3-1-6-1-8 1-2-2-5-2-8-1z"/><path d="M12 6v14"/>',
  volto: '<path d="M12 3c4 0 7 3 7 8l-3 3v6H8v-6l-3-3c0-5 3-8 7-8z"/><path d="M9 12l3 1 3-1"/>',
  bilancia: '<path d="M12 4v16M7 20h10M5 7h14"/><path d="M5 7l-2.5 6h5zM19 7l-2.5 6h5z"/>',
  penna: '<path d="M20 3C12 5 7 11 5 19l2-1c1-4 4-8 8-10"/><path d="M4 21l3-3"/>',
  scaffale: '<path d="M3 20h18"/><rect x="4" y="6" width="3" height="14"/><rect x="8" y="4" width="3" height="16"/><path d="M13 7l3-1 4 13-3 1z"/>',
};
---
<Base titolo="Home">
  <section class="testata">
    <div>
      <h1>Archivio del Credo</h1>
      <p class="lead">Il mio sito su <em>Assassin’s Creed</em>. Ho tutti i giochi e buona parte di libri, fumetti e manga, e volevo un posto dove vedere in che ordine vanno giocati e letti e come si collegano fra loro.</p>
    </div>
    <div id="search" class="search"></div>
  </section>

  <section class="sullo-scaffale" aria-labelledby="titolo-scaffale">
    <div class="sopra">
      <h2 id="titolo-scaffale">Sullo scaffale</h2>
      <div class="chips" role="group" aria-label="Ordine dello scaffale">
        <button class="chip" type="button" data-ordine="uscita" aria-pressed="true">In ordine di uscita</button>
        <button class="chip" type="button" data-ordine="storia" aria-pressed="false">In ordine di storia</button>
      </div>
    </div>
    <p class="conto">Ho {opereMie.size} delle {opere.length} opere uscite finora, in {possedute} pezzi. Tocca un dorso per aprire la sua scheda.</p>
    <Scaffale id="scaffale-uscita" opere={perUscita} possedute={opereMie} etichetta="Opere in ordine di uscita" />
    <Scaffale id="scaffale-storia" opere={perStoria} possedute={opereMie} etichetta="Opere in ordine di storia" hidden />
    <ul class="legenda">
      {tipiPresenti.map((tp) => <li><span class="campione" style={`--c:var(--dorso-${tp})`}></span>{TIPI[tp]}</li>)}
      <li><span class="campione vuoto"></span>Mi manca (<a href={u('/collezione/mancanti')}>lista</a>)</li>
    </ul>
  </section>

  <div class="corpo">
    <nav class="indice" aria-labelledby="titolo-indice">
      <h2 id="titolo-indice">Cosa c’è</h2>
      <ol>
        {indice.map((v) => (
          <li>
            <a href={u(v.href)}>
              <svg class="icona" viewBox="0 0 24 24" aria-hidden="true" set:html={icone[v.icona]} />
              <span class="voce">
                <span class="riga"><span class="nome">{v.nome}</span><span class="puntini" aria-hidden="true"></span><span class="conta">{v.conta}</span></span>
                <span class="desc">{v.desc}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="small muted appendice">Ci sono anche il <a href={u('/personaggi/grafo')}>grafo delle relazioni</a>, <a href={u('/storia/piani')}>i tre piani del racconto</a> e <a href={u('/collezione/mancanti')}>cosa manca alla collezione</a>.</p>
    </nav>

    <aside class="dispacci" aria-labelledby="titolo-dispacci">
      <h2 id="titolo-dispacci">Notizie</h2>
      <ul>
        {ultime.map((n) => (
          <li>
            <p class="eyebrow"><time datetime={n.data.data.toISOString().slice(0, 10)}>{data(n.data.data)}</time>{n.data.stato === 'indiscrezione' && <span class="tag warn">indiscrezione</span>}</p>
            <a href={u(`/notizie#${n.id}`)}>{n.data.titolo}</a>
          </li>
        ))}
      </ul>
      <p class="small"><a href={u('/notizie')}>Tutte le notizie</a></p>
    </aside>
  </div>

  <Fragment slot="head">
    <link href={u('/pagefind/pagefind-ui.css')} rel="stylesheet" />
    <script is:inline src={u('/pagefind/pagefind-ui.js')}></script>
    <script is:inline>
      const avviaRicerca = () => {
        const box = document.getElementById('search');
        if (window.PagefindUI && box && !box.dataset.pronto) {
          box.dataset.pronto = '1';
          new PagefindUI({ element: '#search', showImages: false, translations: { placeholder: 'Cerca un gioco, un personaggio, un luogo…' } });
        }
      };
      window.addEventListener('DOMContentLoaded', avviaRicerca);
      // il campo di Pagefind arriva senza etichetta accessibile
      const etichetta = () => document.querySelector('#search input')?.setAttribute('aria-label', 'Cerca nel sito');
      document.addEventListener('astro:page-load', etichetta);
      setTimeout(etichetta, 300);
      document.addEventListener('astro:page-load', avviaRicerca);

      // scaffale: ordine di uscita o di storia
      const avviaScaffale = () => {
        document.querySelectorAll('[data-ordine]').forEach((b) => {
          if (b.dataset.pronto) return;
          b.dataset.pronto = '1';
          b.addEventListener('click', () => {
            const o = b.dataset.ordine;
            document.querySelectorAll('[data-ordine]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            document.getElementById('scaffale-uscita').hidden = o !== 'uscita';
            document.getElementById('scaffale-storia').hidden = o !== 'storia';
          });
        });
      };
      window.addEventListener('DOMContentLoaded', avviaScaffale);
      document.addEventListener('astro:page-load', avviaScaffale);
    </script>
  </Fragment>
</Base>
<style>
  .testata { display: grid; grid-template-columns: 1fr; gap: 20px 56px; align-items: end; }
  @media (min-width: 860px) { .testata { grid-template-columns: 1.4fr 1fr; } }
  .testata h1 { margin-bottom: .25em; }
  .lead { font-size: 1.15rem; max-width: 58ch; margin: 0; }
  .search { --pagefind-ui-font: var(--testo); --pagefind-ui-border: var(--muted); --pagefind-ui-background: var(--surface); --pagefind-ui-text: var(--ink); --pagefind-ui-primary: var(--ink); --pagefind-ui-border-radius: 2px; --pagefind-ui-border-width: 1px; }

  .sullo-scaffale { margin: 48px 0 56px; }
  .sopra { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; }
  .sopra h2 { margin: 0; }
  .conto { margin: 6px 0 4px; color: var(--muted); }

  .corpo { display: grid; gap: 8px 56px; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .corpo { grid-template-columns: 1.7fr 1fr; } }

  .indice ol { list-style: none; margin: 0; padding: 0; }
  .indice li { position: relative; border-bottom: 1px solid var(--line); }
  .indice li a { display: grid; grid-template-columns: 26px 1fr; gap: 14px; align-items: start; padding: 14px 4px; text-decoration: none; transition: background .2s; }
  .indice li a:hover { color: inherit; background: var(--surface); }
  .icona { width: 24px; height: 24px; margin-top: 5px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; color: var(--muted); transition: color .2s, rotate .3s; }
  .indice li a:hover .icona { color: var(--ink); }
  .riga { display: flex; align-items: baseline; gap: 8px; }
  .nome { font: 600 1.35rem/1.3 var(--titoli); }
  .puntini { flex: 1; border-bottom: 2px dotted color-mix(in srgb, var(--muted) 55%, transparent); translate: 0 -5px; min-width: 20px; }
  .conta { font: 500 .9rem var(--titoli); color: var(--muted); white-space: nowrap; }
  .desc { display: block; color: var(--muted); font-size: .98rem; }
  .appendice { margin-top: 18px; }

  .dispacci ul { list-style: none; margin: 0; padding: 0; }
  .dispacci li { padding: 12px 0 14px; border-bottom: 1px solid var(--line); }
  .dispacci li .eyebrow { margin: 0 0 4px; display: flex; gap: 8px; align-items: center; }
  .dispacci li a { font: 600 1.15rem/1.3 var(--titoli); text-decoration: none; }
  .dispacci li a:hover { text-decoration: underline; }
  @media (min-width: 860px) {
    .dispacci { background: var(--surface); border: 1px solid var(--line); padding: 4px 22px 16px; align-self: start; margin-top: 2.2em; }
    .dispacci h2 { margin-top: .8em; }
  }
</style>
