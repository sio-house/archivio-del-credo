---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { dati } from '../../lib/data';
const { percorsi } = await dati();
const livelli = { 'nuovo-arrivato': 'Per iniziare', appassionato: 'Per appassionati', completista: 'Per completisti' };
---
<Base titolo="Percorsi" descrizione="In che ordine giocare e leggere Assassin's Creed: percorsi curati e ordini automatici.">
  <h1>Percorsi</h1>
  <p class="muted">Guide all'ordine di fruizione. Quelle curate hanno note e passi opzionali; le altre due sono generate dai dati.</p>
  <h2>Curati</h2>
  <div class="grid">
    {percorsi.map((p) => (
      <a class="card" href={u(`/percorsi/${p.id}`)}>
        <p class="eyebrow">{livelli[p.data.livello]} · {p.data.passi.length} passi</p>
        <h3>{p.data.titolo}</h3>
        <p class="small muted">{p.data.sommario}</p>
      </a>
    ))}
  </div>
  <h2>Automatici</h2>
  <div class="grid">
    <a class="card" href={u('/percorsi/cronologico')}><p class="eyebrow">Generato</p><h3>Ordine cronologico</h3><p class="small muted">Nell'ordine in cui accadono gli eventi.</p></a>
    <a class="card" href={u('/percorsi/uscita')}><p class="eyebrow">Generato</p><h3>Ordine di uscita</h3><p class="small muted">Come li hanno vissuti i fan, anno dopo anno.</p></a>
  </div>
</Base>
