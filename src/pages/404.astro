---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base titolo="Pagina non trovata" descrizione="La pagina che cercavi non esiste o è stata spostata.">
  
  <h1>Pagina non trovata</h1>
  <p class="lead muted">Questa pagina non esiste, oppure l'ho spostata. Puoi ripartire da qui:</p>
  <p class="chips">
    <a class="chip" href={u('/')}>Home</a>
    <a class="chip" href={u('/timeline')}>Timeline</a>
    <a class="chip" href={u('/opere')}>Opere</a>
    <a class="chip" href={u('/personaggi')}>Personaggi</a>
  </p>
</Base>
<style>.lead { font-size: 1.1rem; max-width: 60ch; }</style>
