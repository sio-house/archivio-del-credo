---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Scaffale from '../components/Scaffale.astro';
import { dati, TIPI, type Opera } from '../lib/data';
const { idx, opere, copie, perUscita } = await dati();

const righe = copie.map((c) => {
  const e = idx.edizioni.get(c.data.edizione.id)!;
  return { c, e, o: idx.opere.get(e.data.opera.id)! as Opera };
}).sort((a, b) => +a.o.data.uscita - +b.o.data.uscita);

const possedute = righe.filter((r) => r.c.data.stato === 'posseduto');
const opereCoperte = new Set(possedute.map((r) => r.o.id));
const completate = possedute.filter((r) => r.c.data.fruizione === 'completato' || r.c.data.fruizione === 'platinato').length;
const desiderate = righe.filter((r) => r.c.data.stato === 'desiderato');
const perTipo = Object.entries(TIPI).map(([t, label]) => {
  const tot = opere.filter((o) => o.data.tipo === t).length;
  const mie = opere.filter((o) => o.data.tipo === t && opereCoperte.has(o.id)).length;
  return { tipo: t, label, tot, mie, lista: perUscita.filter((o) => o.data.tipo === t) };
}).filter((x) => x.tot > 0);
const frase = [
  `Ho ${possedute.length} pezzi che coprono ${opereCoperte.size} delle ${opere.length} opere.`,
  completate > 0 ? `Ne ho finite ${completate}.` : '',
  desiderate.length > 0 ? `In lista desideri: ${desiderate.length}.` : '',
].filter(Boolean).join(' ');
const fruizione = { 'da-iniziare': 'Da iniziare', 'in-corso': 'In corso', completato: 'Completato', platinato: 'Platinato' };
---
<Base titolo="Collezione">
  <h1>Collezione</h1>
  <p class="lead">{frase} I dorsi vuoti sono quelli che mi mancano; la <a href={u('/collezione/mancanti')}>lista completa</a> li ordina per quanto contano nei percorsi.</p>

  {perTipo.map((t) => (
    <section class="ripiano" aria-labelledby={`rip-${t.tipo}`}>
      <h2 id={`rip-${t.tipo}`}>{t.label}</h2>
      <p class="quanti">{t.mie} su {t.tot}</p>
      <Scaffale opere={t.lista} possedute={opereCoperte} etichetta={`${t.label}: ${t.mie} su ${t.tot} in collezione`} />
    </section>
  ))}

  <h2>Tutti i pezzi</h2>
  <div class="table-scroll">
    <table class="a-schede">
      <thead><tr><th>Opera</th><th>Edizione</th><th>Lingua</th><th>Stato</th><th>Fruizione</th><th>Voto</th></tr></thead>
      <tbody>
        {righe.map(({ c, e, o }) => (
          <tr>
            <td><a href={u(`/opere/${o.id}`)}>{o.data.titolo}</a><div class="small muted">{TIPI[o.data.tipo]}</div></td>
            <td data-col="Edizione">{e.data.nome}{e.data.piattaforma && <span class="muted">, {e.data.piattaforma}</span>}{e.data.isbn && <div class="small muted">ISBN {e.data.isbn}</div>}</td>
            <td data-col="Lingua">{e.data.lingua.toUpperCase()}</td>
            <td data-col="Stato"><span class="tag">{c.data.stato}</span></td>
            <td data-col="Fruizione">{c.data.fruizione ? fruizione[c.data.fruizione] : 'non segnata'}</td>
            <td data-col="Voto">{c.data.voto ?? 'nessuno'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
<style>
  .lead { max-width: 64ch; font-size: 1.1rem; }
  .ripiano h2 { margin: 1.6em 0 .1em; }
  .quanti { font: 500 1rem var(--titoli); color: var(--muted); margin: 0 0 .6em; }
</style>
