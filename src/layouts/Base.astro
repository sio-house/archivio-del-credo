---
import { u, senzaBase } from '../lib/url';
import '../styles/global.css';
import '../styles/animus.css';
import Animus from '../components/Animus.astro';
import Intro from '../components/Intro.astro';
import Glifo from '../components/Glifo.astro';
import { ClientRouter } from 'astro:transitions';
interface Props { titolo: string; descrizione?: string }
const { titolo, descrizione = "Portale non ufficiale su Assassin's Creed: timeline, guide all'ordine di lettura e una collezione." } = Astro.props;
const voci = [
  ['/timeline', 'Timeline'], ['/mappa', 'Mappa'], ['/percorsi', 'Percorsi'], ['/opere', 'Opere'], ['/storia', 'Storia'],
  ['/personaggi', 'Personaggi'], ['/glossario', 'Glossario'], ['/collezione', 'Collezione'], ['/notizie', 'Notizie'], ['/about', 'Info'],
];
const qui = Astro.url.pathname;            // include il base, se c'è
const relativo = senzaBase(qui);            // lo stesso percorso visto dalla radice del sito
// ogni pagina ha la sua anteprima social, generata in build
const slug = relativo === '/' ? 'home' : relativo.replace(/^\/|\/$/g, '');
const og = new URL(u(`/og/${slug}.png`), Astro.site);
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titolo} · Archivio del Credo</title>
  <meta name="description" content={descrizione} />
  <link rel="canonical" href={new URL(qui, Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=IBM+Plex+Mono:wght@400;500&family=Spectral:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Archivio del Credo" />
  <meta property="og:title" content={titolo} />
  <meta property="og:description" content={descrizione} />
  <meta property="og:url" content={new URL(qui, Astro.site)} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="Archivio del Credo · Notizie" href={u('/notizie.xml')} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <ClientRouter />
  <slot name="head" />
</head>
<body>
  <Intro />
  <header class="top">
    <div class="wrap bar">
      <a href={u('/')} class="brand"><Glifo size={26} /> <span>Archivio del Credo</span></a>
      <nav>
        {voci.map(([href, label]) => (
          <a href={u(href)} aria-current={relativo.startsWith(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <Animus />
    </div>
  </header>
  <main class="wrap" data-pagefind-body>
    <slot />
  </main>
  <footer class="wrap small muted">
    <p class="mano firma">compilato a mano, un'opera alla volta</p>
    Sito amatoriale non ufficiale, non affiliato né approvato da Ubisoft. Assassin's Creed è un marchio di Ubisoft Entertainment.
    · Un progetto di <a href="https://s-io.net">S-IO</a>
  </footer>
</body>
</html>
<style>
  .top { border-bottom: 3px double var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(6px); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; gap: 12px 24px; min-height: 60px; flex-wrap: wrap; padding-block: 8px; }
  .bar :global(.animus-btn) { margin-left: auto; }
  .brand { font-family: var(--serif); font-size: 1.4rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; }
  .brand :global(.glifo) { color: var(--ink); --glifo-occhio: var(--accent); transition: transform .6s cubic-bezier(.2,.8,.2,1); }
  .brand :global(.glifo-gemma) { color: var(--accent); }
  .brand:hover :global(.glifo) { transform: rotate(45deg); }
  nav { display: flex; gap: 4px 16px; flex-wrap: wrap; font-size: .95rem; font-style: italic; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a[aria-current='page'] { color: var(--ink); text-decoration: none; background: var(--inchiostro) no-repeat 0 100% / 100% 6px; padding-bottom: 3px; }
  main { padding-block: 40px 64px; min-height: 70vh; }
  footer { border-top: 3px double var(--line); padding-block: 20px 40px; }
  .firma { margin: 0 0 6px; }
</style>
