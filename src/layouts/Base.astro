---
import { u, senzaBase } from '../lib/url';
import '../styles/global.css';
import '../styles/animus.css';
import Animus from '../components/Animus.astro';
import Intro from '../components/Intro.astro';
import { ClientRouter } from 'astro:transitions';
interface Props { titolo: string; descrizione?: string }
const { titolo, descrizione = "Sito non ufficiale su Assassin's Creed: giochi, libri, fumetti e manga in ordine, con la mia collezione." } = Astro.props;
const voci = [
  ['/timeline', 'Timeline'], ['/mappa', 'Mappa'], ['/percorsi', 'Percorsi'], ['/opere', 'Opere'], ['/storia', 'Storia'],
  ['/personaggi', 'Personaggi'], ['/glossario', 'Glossario'], ['/collezione', 'Collezione'], ['/notizie', 'Notizie'], ['/about', 'Info'],
];
const qui = Astro.url.pathname;            // include il base, se c'è
const relativo = senzaBase(qui);            // lo stesso percorso visto dalla radice del sito
// ogni pagina ha la sua anteprima social, generata in build
const slug = relativo === '/' ? 'home' : relativo.replace(/^\/|\/$/g, '');
const og = new URL(u(`/og/${slug}.png`), Astro.site);
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titolo} · Archivio del Credo</title>
  <meta name="description" content={descrizione} />
  <link rel="canonical" href={new URL(qui, Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Cormorant+Garamond:ital,wght@0,600;1,500&display=swap" rel="stylesheet" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Archivio del Credo" />
  <meta property="og:title" content={titolo} />
  <meta property="og:description" content={descrizione} />
  <meta property="og:url" content={new URL(qui, Astro.site)} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="Archivio del Credo · Notizie" href={u('/notizie.xml')} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <ClientRouter />
  <slot name="head" />
</head>
<body>
  <Intro />
  <header class="top">
    <div class="wrap bar">
      <a href={u('/')} class="brand">Archivio del Credo</a>
      <nav>
        {voci.map(([href, label]) => (
          <a href={u(href)} aria-current={relativo.startsWith(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <Animus />
    </div>
  </header>
  <main class="wrap" data-pagefind-body>
    <slot />
  </main>
  <footer class="wrap small muted">
    <p>Sito amatoriale, non ufficiale e non collegato a Ubisoft. Assassin's Creed è un marchio di Ubisoft Entertainment.</p>
    <p>Fatto da Alessio, <a href="https://s-io.net">S-IO</a>.</p>
  </footer>
</body>
</html>
<style>
  .top { border-bottom: 1px solid var(--line); background: var(--bg); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; gap: 8px 28px; min-height: 64px; flex-wrap: wrap; padding-block: 10px; }
  .bar :global(.animus-btn) { margin-left: auto; }
  .brand { font: 700 1.45rem/1 var(--titoli); letter-spacing: -.01em; text-decoration: none; }
  nav { display: flex; gap: 2px 18px; flex-wrap: wrap; font: 500 1rem/1 var(--titoli); }
  nav a { text-decoration: none; color: var(--muted); padding: 8px 0; border-bottom: 3px solid transparent; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--ink); }
  main { padding-block: 44px 72px; min-height: 70vh; }
  footer { border-top: 1px solid var(--line); padding-block: 20px 40px; }
  footer p { margin: 0 0 4px; max-width: 70ch; }
</style>
